<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/argisview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.cs567_3d_ui_project.activities.ARGISActivity">

    <!--Icons are found here and are editable: https://www.flaticon.com-->
    <!-- How to add an icon https://www.geeksforgeeks.org/android/how-to-add-image-to-drawable-folder-in-android-studio/-->

    <android.opengl.GLSurfaceView
        android:id="@+id/surfaceview"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="top"/>

    <View
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/simple_reticle"
        android:layout_centerInParent="true" />

    <TextView
        android:id="@+id/inferenceResults"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#AAFFFFFF"
        android:fontFamily="monospace"
        android:textColor="@android:color/black"
        android:layout_alignParentTop="true"
        tools:text="@string/inferenceResults" />

    <TextView
        android:id="@+id/earthStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#AAFFFFFF"
        android:fontFamily="monospace"
        android:textColor="@android:color/black"
        android:layout_alignParentBottom="true"
        tools:text="@string/earth_state" />

    <TextView
        android:id="@+id/scaleFactor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:layout_margin="25dp"
        android:text="@string/scalefactor_1_0x"
        android:textColor="@color/white"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:background="@android:color/transparent"/>
    
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/editing"
            android:visibility="gone"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/rotateAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/rotatemodels"
            android:visibility="gone"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/scaleAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/scale"
            android:visibility="gone"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/align"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/eraser_tool"
            android:visibility="gone"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/playRecording"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/play"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/pause"
            android:visibility="gone"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/stopPlayback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/stop"
            android:visibility="gone"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/objectDetection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="25dp"
            android:src="@drawable/magnify_glass"
            android:background="@android:color/transparent"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ImageButton
                android:id="@+id/rotateModelXAxis"
                android:src="@drawable/xaxis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="25dp"
                android:visibility="invisible"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/rotateModelYAxis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                android:layout_margin="25dp"
                android:src="@drawable/yaxis"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/rotateModelZAxis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                android:layout_margin="25dp"
                android:src="@drawable/zaxis"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/pauseModelRotation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_margin="25dp"
                android:src="@drawable/pause"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/stopModelRotation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_margin="25dp"
                android:src="@drawable/back_arrow"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/stopScaling"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_margin="25dp"
                android:src="@drawable/back_arrow"
                android:background="@android:color/transparent"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/save"
                android:src="@drawable/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="25dp"
                android:visibility="invisible"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                android:layout_margin="25dp"
                android:src="@drawable/cancel"
                android:background="@android:color/transparent"/>

            <ImageButton
                android:id="@+id/undo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="invisible"
                android:layout_margin="25dp"
                android:src="@drawable/undo"
                android:background="@android:color/transparent"/>
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_alignParentStart="true"
        android:layout_marginTop="25dp"
        android:layout_alignParentTop="true">
        <ImageButton
            android:id="@+id/scaleUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:layout_margin="25dp"
            android:src="@drawable/arrow_up"
            android:background="@android:color/transparent"/>

        <ImageButton
            android:id="@+id/scaleDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:layout_margin="25dp"
            android:src="@drawable/arrow_down"
            android:background="@android:color/transparent"/>

    </LinearLayout>


</RelativeLayout>